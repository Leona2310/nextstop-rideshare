rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    /* ================= HELPERS ================= */

    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return request.auth.token.admin == true;
    }

    /* ================= USERS ================= */

    match /users/{userId} {
      allow read, write: if isAuthenticated() && request.auth.uid == userId;
      allow read, write: if isAdmin();
    }

    /* ================= PUSH TOKENS ================= */

    match /publicPushTokens/{userId} {
      allow read, create, update: if isAuthenticated();
    }

    /* ================= RIDES ================= */

    match /rides/{rideId} {

      /* ===== READ ===== */
      allow read: if isAuthenticated();

      /* ===== CREATE ===== */
      allow create: if isAuthenticated()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.driverId == null
        && request.resource.data.status == "SEARCHING"
        && request.resource.data.passengers is list
        && request.resource.data.passengers.size() == 1
        && request.resource.data.passengers[0] == request.auth.uid
        && request.resource.data.currentSeats == 1;

      /* ===== UPDATE (JOIN / LEAVE / DRIVER) ===== */
      allow update: if isAuthenticated() && (

        // Admin full control
        isAdmin()

        // Driver can update
        || resource.data.driverId == request.auth.uid

        || (
          request.auth != null
          && request.resource.data.driverId == request.auth.uid
          && resource.data.driverId == null
          && resource.data.status == "SEARCHING"
          && request.resource.data.status == "ACCEPTED"
        )

        // Allow the assigned driver to mark arrival at pickup
        || (
          request.auth != null
          && request.auth.uid == resource.data.driverId
          && request.resource.data.status == "ARRIVED"
        )

        // Owner (creator) may cancel the ride by setting status to 'cancelled' and cancelledAt only
        || (
          (resource.data.userId == request.auth.uid || resource.data.createdBy == request.auth.uid)
          && request.resource.data.status == 'cancelled'
          && request.resource.data.diff(resource.data).changedKeys().hasOnly(['status', 'cancelledAt'])
        )

        // Passenger can update (join/leave)
        || request.auth.uid in (resource.data.passengers || [])

        // Allow join/leave updates
        || request.resource.data.diff(resource.data)
             .changedKeys()
             .hasOnly(['passengers', 'currentSeats'])
      );

      /* ===== DELETE ===== */
      allow delete: if isAdmin();
    }

    /* ================= OTHER COLLECTIONS ================= */

    match /driver_offers/{offerId} {
      allow read: if isAuthenticated();
  // Create: allow authenticated clients to create offers (sendOffers runs client-side in this project)
  // Also allow admins to create offers (e.g., server-side or callable functions)
  allow create: if isAuthenticated() || isAdmin();
      // Update: only the intended driver or admin may change the offer (e.g., accept/reject)
      allow update: if isAdmin() || (isAuthenticated() && resource.data.driverId == request.auth.uid && (
        // Only allow status transitions and timestamps to be modified by the driver
        request.resource.data.diff(resource.data).changedKeys().hasOnly(['status', 'acceptedAt', 'rejectedAt'])
      ));
      // Delete: admin only
      allow delete: if isAdmin();
    }

    match /rideOffers/{offerId} {
      allow read, write: if isAuthenticated();
    }

    match /activeDrivers/{driverId} {
      allow read: if isAuthenticated();
      allow write: if request.auth.uid == driverId;
    }

    match /drivers/{driverId} {
      // Drivers may read their own profile and update their own status (isOnline)
      allow read: if isAuthenticated();
  // Allow drivers to write their own document, and admins to manage driver documents
  allow write: if isAdmin() || (isAuthenticated() && request.auth.uid == driverId);
  allow create: if isAdmin() || (isAuthenticated() && request.auth.uid == driverId);
    }

    /* ================= STUDENTS ================= */
    // Allow authenticated users to create and manage their own student profile
    match /students/{studentId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.auth.uid == studentId;
      allow update: if isAuthenticated() && request.auth.uid == studentId;
      allow delete: if isAdmin();
      // Admins have full control
      allow read, write: if isAdmin();
    }

    match /bookings/{bookingId} {
      allow read, write: if isAuthenticated();
    }

    match /announcements/{announcementId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    /* ================= FALLBACK ================= */

    match /{document=**} {
      allow read, write: if false;
    }
  }
}